# Design CRM — frontend environment variables
# Copy to ".env" (or ".env.local") for local dev. Vite only exposes VITE_* vars.

# Base URL of the Design CRM backend API (see Backend/.env.example).
# Local dev default:
VITE_API_URL=http://localhost:5006/api
# Production example:
# VITE_API_URL=https://api-designcrm.tescomanagement.com/api
